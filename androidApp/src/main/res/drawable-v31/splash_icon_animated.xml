<!-- Splash animation: the checker alone, then the arrows grow out of it from left to right.
     Each arrow is one animator over the whole 1350 ms with keyframes (hidden, then grows, then
     stays), which the system splash plays more reliably than delayed sequential animators.
     Keep the total in sync with SPLASH_ANIMATION_MILLIS in MainActivity and
     windowSplashScreenAnimationDuration in values/themes.xml. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_icon">
    <target android:name="arrow_left">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1350">
            <propertyValuesHolder
                android:propertyName="scaleX"
                android:valueType="floatType">
                <keyframe
                    android:fraction="0"
                    android:value="0" />
                <keyframe
                    android:fraction="0.3704"
                    android:value="0" />
                <keyframe
                    android:fraction="0.6296"
                    android:interpolator="@android:interpolator/overshoot"
                    android:value="1" />
                <keyframe
                    android:fraction="1"
                    android:value="1" />
            </propertyValuesHolder>
            <propertyValuesHolder
                android:propertyName="scaleY"
                android:valueType="floatType">
                <keyframe
                    android:fraction="0"
                    android:value="0" />
                <keyframe
                    android:fraction="0.3704"
                    android:value="0" />
                <keyframe
                    android:fraction="0.6296"
                    android:interpolator="@android:interpolator/overshoot"
                    android:value="1" />
                <keyframe
                    android:fraction="1"
                    android:value="1" />
            </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="arrow_front">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1350">
            <propertyValuesHolder
                android:propertyName="scaleX"
                android:valueType="floatType">
                <keyframe
                    android:fraction="0"
                    android:value="0" />
                <keyframe
                    android:fraction="0.5556"
                    android:value="0" />
                <keyframe
                    android:fraction="0.8148"
                    android:interpolator="@android:interpolator/overshoot"
                    android:value="1" />
                <keyframe
                    android:fraction="1"
                    android:value="1" />
            </propertyValuesHolder>
            <propertyValuesHolder
                android:propertyName="scaleY"
                android:valueType="floatType">
                <keyframe
                    android:fraction="0"
                    android:value="0" />
                <keyframe
                    android:fraction="0.5556"
                    android:value="0" />
                <keyframe
                    android:fraction="0.8148"
                    android:interpolator="@android:interpolator/overshoot"
                    android:value="1" />
                <keyframe
                    android:fraction="1"
                    android:value="1" />
            </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="arrow_right">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1350">
            <propertyValuesHolder
                android:propertyName="scaleX"
                android:valueType="floatType">
                <keyframe
                    android:fraction="0"
                    android:value="0" />
                <keyframe
                    android:fraction="0.7407"
                    android:value="0" />
                <keyframe
                    android:fraction="1"
                    android:interpolator="@android:interpolator/overshoot"
                    android:value="1" />
            </propertyValuesHolder>
            <propertyValuesHolder
                android:propertyName="scaleY"
                android:valueType="floatType">
                <keyframe
                    android:fraction="0"
                    android:value="0" />
                <keyframe
                    android:fraction="0.7407"
                    android:value="0" />
                <keyframe
                    android:fraction="1"
                    android:interpolator="@android:interpolator/overshoot"
                    android:value="1" />
            </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
