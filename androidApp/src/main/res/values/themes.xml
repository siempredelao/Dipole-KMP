<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme: shows the splash screen, then switches to the app's normal theme. -->
    <style name="Theme.Dipole.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <!-- Only read before Android 13; later versions take the length from the animation itself. -->
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@android:style/Theme.Material.NoActionBar</item>
    </style>
</resources>
