<?xml version="1.0" encoding="utf-8"?>
<!-- Splash animation: the checker alone, then the arrows grow out of it from left to right.
     Each arrow is one animator over the whole 850 ms with keyframes (hidden, then grows, then
     stays), which the system splash plays more reliably than delayed sequential animators.
     Keep the total in sync with SPLASH_ANIMATION_MILLIS in MainActivity. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_icon">
    <target android:name="arrow_left">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="850">
            <propertyValuesHolder
                android:propertyName="scaleX"
                android:valueType="floatType">
                <keyframe
                    android:fraction="0"
                    android:value="0" />
                <keyframe
                    android:fraction="0.2353"
                    android:value="0" />
                <keyframe
                    android:fraction="0.5294"
                    android:interpolator="@android:interpolator/overshoot"
                    android:value="1" />
                <keyframe
                    android:fraction="1"
                    android:value="1" />
            </propertyValuesHolder>
            <propertyValuesHolder
                android:propertyName="scaleY"
                android:valueType="floatType">
                <keyframe
                    android:fraction="0"
                    android:value="0" />
                <keyframe
                    android:fraction="0.2353"
                    android:value="0" />
                <keyframe
                    android:fraction="0.5294"
                    android:interpolator="@android:interpolator/overshoot"
                    android:value="1" />
                <keyframe
                    android:fraction="1"
                    android:value="1" />
            </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="arrow_front">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="850">
            <propertyValuesHolder
                android:propertyName="scaleX"
                android:valueType="floatType">
                <keyframe
                    android:fraction="0"
                    android:value="0" />
                <keyframe
                    android:fraction="0.4706"
                    android:value="0" />
                <keyframe
                    android:fraction="0.7647"
                    android:interpolator="@android:interpolator/overshoot"
                    android:value="1" />
                <keyframe
                    android:fraction="1"
                    android:value="1" />
            </propertyValuesHolder>
            <propertyValuesHolder
                android:propertyName="scaleY"
                android:valueType="floatType">
                <keyframe
                    android:fraction="0"
                    android:value="0" />
                <keyframe
                    android:fraction="0.4706"
                    android:value="0" />
                <keyframe
                    android:fraction="0.7647"
                    android:interpolator="@android:interpolator/overshoot"
                    android:value="1" />
                <keyframe
                    android:fraction="1"
                    android:value="1" />
            </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="arrow_right">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="850">
            <propertyValuesHolder
                android:propertyName="scaleX"
                android:valueType="floatType">
                <keyframe
                    android:fraction="0"
                    android:value="0" />
                <keyframe
                    android:fraction="0.7059"
                    android:value="0" />
                <keyframe
                    android:fraction="1"
                    android:interpolator="@android:interpolator/overshoot"
                    android:value="1" />
            </propertyValuesHolder>
            <propertyValuesHolder
                android:propertyName="scaleY"
                android:valueType="floatType">
                <keyframe
                    android:fraction="0"
                    android:value="0" />
                <keyframe
                    android:fraction="0.7059"
                    android:value="0" />
                <keyframe
                    android:fraction="1"
                    android:interpolator="@android:interpolator/overshoot"
                    android:value="1" />
            </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
